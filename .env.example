# Database
DATABASE_URI=postgresql://middlepoint:middlepoint_secret@localhost:5432/middlepoint

# Payload CMS
PAYLOAD_SECRET=your-super-secret-payload-key-min-32-chars
# Solo dev / primer deploy prod con BD vacía; no dejar true en prod estable
PAYLOAD_DB_PUSH=false
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Auth.js
AUTH_SECRET=your-auth-secret-min-32-characters-long
AUTH_URL=http://localhost:3000

# JWT
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# Rate Limiting (optional Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@middlepoint.do

# WhatsApp hook (optional)
WHATSAPP_WEBHOOK_URL=

# Vercel Blob (obligatorio en producción para subir imágenes)
# Se crea en Vercel → Storage → Blob; suele inyectar BLOB_READ_WRITE_TOKEN solo.
BLOB_READ_WRITE_TOKEN=

# Timezone
TZ=America/Santo_Domingo

# Default currency
DEFAULT_CURRENCY=DOP
EXCHANGE_RATE_USD=58.50
