    "terminos": {
      "title": "Términos y condiciones",
      "updated": "Última actualización: 2026",
      "intro": "Al utilizar Tu Punto Medio aceptas los siguientes términos de servicio.",
      "body": "Los productos están sujetos a disponibilidad. Los precios pueden variar sin previo aviso. El usuario es responsable de proporcionar información de contacto y entrega correcta. Tu Punto Medio se reserva el derecho de cancelar pedidos en casos de fraude o error evidente."
    },
    "privacidad": {
      "title": "Política de privacidad",
      "updated": "Última actualización: 2026",
      "intro": "Tu Punto Medio protege tus datos personales conforme a la legislación dominicana.",
      "body": "Recopilamos nombre, email, teléfono y dirección únicamente para procesar pedidos y mejorar tu experiencia. No vendemos ni compartimos tus datos con terceros, excepto proveedores necesarios para entrega y pagos. Puedes solicitar acceso o eliminación de tus datos escribiendo a hello@tupuntomedio.com."
    },
    "devoluciones": {
      "title": "Política de devoluciones",
      "updated": "Última actualización: 2026",
      "intro": "Queremos que estés satisfecho con cada pedido de Tu Punto Medio.",
      "body": "Por la naturaleza de nuestros productos perecederos, las devoluciones aplican solo si el pedido llega dañado o incorrecto. Debes reportarlo dentro de las 2 horas posteriores a la entrega con foto del producto. Evaluaremos reembolso parcial o reenvío según corresponda."
    },
    "faq": {
      "title": "Preguntas frecuentes",
      "q1": {
        "question": "¿Cuáles son los métodos de pago?",
        "answer": "Aceptamos efectivo y transferencia bancaria. Próximamente Stripe y PayPal."
      },
      "q2": {
        "question": "¿Hacen entregas en todo Santo Domingo?",
        "answer": "Sí, cubrimos la mayoría de zonas del Gran Santo Domingo. Al checkout puedes programar fecha y hora."
      },
      "q3": {
        "question": "¿Puedo modificar mi pedido?",
        "answer": "Puedes contactarnos por WhatsApp antes de que el pedido entre en preparación."
      },
      "q4": {
        "question": "¿Los productos son frescos?",
        "answer": "Todos nuestros bowls, smoothies y snacks se preparan con ingredientes naturales el mismo día de la entrega."
      }
    }
