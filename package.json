{
  "name": "middlepoint",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@middlepoint/web",
    "build": "npm run build --workspace=@middlepoint/web",
    "start": "npm run start --workspace=@middlepoint/web",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=@middlepoint/web",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
